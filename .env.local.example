# Get this from your Neon project dashboard → Connection Details → Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: lets you upload photos/PDFs (of patterns, yarn, etc.). Create a
# Vercel Blob store and paste its token here. Without it, you can still paste
# pattern text — only photo/PDF upload is affected.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Optional: enables AI reading of pattern PHOTOS and PDFs on the Pattern Tracker.
# Get a key at https://console.anthropic.com. Without it, the Pattern Tracker
# still works with the built-in text parser (paste your pattern as text).
# ANTHROPIC_API_KEY="sk-ant-xxx"

# Optional: which Claude model reads your patterns. Defaults to claude-opus-5-5.
# For lower cost, you can switch to a smaller model, e.g. claude-haiku-5-5.
# PATTERN_PARSE_MODEL="claude-opus-5-5"
